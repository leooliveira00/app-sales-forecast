# ============================================================
# ROOT .env — lido pelo Docker Compose (docker compose up)
#
# Copie para .env e preencha os valores. Este arquivo NÃO é lido
# diretamente pelo código; serve para substituição de variáveis no
# docker-compose.yml e injeção como env nos containers.
# Scripts locais (seed, db:push) usam backend/.env separadamente.
# ============================================================

# --- Ambiente (prefixo dos containers + roteamento Traefik) ---
# ENV_PREFIX: prefixo dos container_name e routers do Traefik (dev | hml | prod)
# APP_DOMAIN: Host roteado pelo Traefik para o frontend
ENV_PREFIX=prod
APP_DOMAIN=sales-forecast-web.example.com
# Roteamento Traefik: HTTPS (websecure + tls) é fixo no docker-compose.yml.
# FRONTEND_CERTRESOLVER decide a origem do certificado:
#   - vazio  : cert ESTÁTICO do file provider do Traefik (ex.: dev com CA interna / Windows AD)
#   - tlsalpn: emite/renova via TLS-ALPN-01 (Let's Encrypt, automático, só pela 443) -> produção
# Requisitos do TLS-ALPN-01 em produção:
#   - A record APP_DOMAIN -> IP público (estático, manual, uma única vez)
#   - porta 443 PADRÃO acessível pela internet e chegando direto no Traefik
#     (NÃO funciona atrás de NAT com porta personalizada, ex.: 50001->443)
#   - resolver "tlsalpn" definido no app-traefik (acme.tlschallenge=true)
FRONTEND_CERTRESOLVER=tlsalpn

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=forecastdb
# Porta exposta no host (interno sempre 5432)
POSTGRES_PORT=5433

# --- Backend ---
# OBRIGATÓRIO em produção: gere com `openssl rand -hex 64`
JWT_SECRET="change-this-to-a-long-random-secret-before-production"

# --- Airflow ---
# O backend exige essas 3 variáveis definidas no startup (validateEnv em
# backend/src/config/env.ts), mesmo sem Airflow rodando — preencha com qualquer
# valor placeholder se não for usar a integração; elas só falham de fato se algo
# tentar disparar uma DAG.
AIRFLOW_BASE_URL=
AIRFLOW_USER=
AIRFLOW_PASSWORD=

# --- Sync interno (Airflow -> Backend) ---
# Gere com: openssl rand -hex 32
INTERNAL_SYNC_TOKEN=

# --- CORS / origem do frontend em produção ---
CORS_ORIGIN=https://sales-forecast-web.example.com

# --- Admin inicial (criado apenas se ainda não existir no banco) ---
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=