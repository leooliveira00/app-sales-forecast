# Copie este arquivo para .env e preencha os valores
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forecastdb"

# OBRIGATÓRIO em produção: use uma string longa e aleatória
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-secret-before-production"

PORT=3000
NODE_ENV=development

# Origem permitida pelo CORS em produção (ex: https://sales-forecast-web.example.com)
# Se não definida, CORS permanece aberto — compatível com dev local
CORS_ORIGIN=

# Credenciais do admin inicial (cria o usuário apenas se ainda não existir no banco)
# Remova ou deixe em branco após o primeiro deploy para desabilitar criação automática
# Gere senha com: node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
